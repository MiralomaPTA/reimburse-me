# Copy to .env.local for development. Defaults work for local development with no Google setup.

# Public URL used in emailed links.
APP_URL=http://localhost:3000

# "local" (default): files in ./.data, emails printed to the console and saved to ./.data/outbox.
# "google": Drive, Sheets and Gmail as fs@miralomasf.com. Requires the GOOGLE_* values below.
# A production build refuses "local" (it would write to the serverless disk and lose everything)
# unless ALLOW_LOCAL_ADAPTERS_IN_PRODUCTION=1, which is only for trying `next start` on a laptop.
ADAPTERS=local

# Random secret for signing sessions and sign-in links. Required in production.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

AP_EMAIL=ap@miralomasf.com
# Who gets the signed packet. "requester" (default): only the person who signed, who forwards it to
# AP_EMAIL by hand; use this while the portal is being tried out. "ap": AP_EMAIL gets it and the
# requester gets a copy.
SEND_PACKETS_TO=requester
# Who gets "please approve this new user" emails. Defaults to AP_EMAIL.
APPROVER_EMAIL=
FROM_EMAIL=fs@miralomasf.com
FROM_NAME=Miraloma PTA Reimbursements

# --- Google Workspace (ADAPTERS=google) ---
# Service account with domain-wide delegation for Drive, Sheets and Gmail scopes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON. Keep the literal \n line breaks when pasting into Vercel.
GOOGLE_PRIVATE_KEY=
# Workspace user the service account acts as. Defaults to FROM_EMAIL.
GOOGLE_IMPERSONATE_EMAIL=fs@miralomasf.com
# Folder in fs@'s Drive that holds pending/ and requests/.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# The request-log spreadsheet and the tab to use.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Requests
# Tab holding the allow-list / AP list (created with headers on first use).
GOOGLE_USERS_SHEET_NAME=Users
# Tab holding the classroom, field-trip and per-grade stipend amounts (created with headers on first use).
GOOGLE_STIPENDS_SHEET_NAME=Stipends
